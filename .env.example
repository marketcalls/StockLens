# FinEdge financial data API
# Get your key from https://www.finedgeapi.com profile > API Keys
# Passed as the `token` query parameter on every request. Never expose to the browser.
FINEDGE_API_KEY=your_finedge_api_key_here

# FinEdge API host
FINEDGE_BASE_URL=https://data.finedgeapi.com

# Ingestion rate control. FinEdge publishes no rate limit and returns no rate-limit
# headers, so this defaults conservative. See docs/prd/09-open-questions.md Q1.
FINEDGE_MAX_RPS=5
FINEDGE_TIMEOUT_SECONDS=60
FINEDGE_MAX_RETRIES=4

# Databases
STOCKLENS_DB_PATH=data/stocklens.db
STOCKLENS_RAW_DB_PATH=data/stocklens_raw.db

# Auth
# At least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default outside local development.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY_MINUTES=10080

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
